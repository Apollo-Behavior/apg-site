# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/
# X-Robots-Tag keeps the review preview out of search (covers images too, unlike the meta tag).
# TODO(launch): remove the X-Robots-Tag line under /* when this becomes the live autismga.org site.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Keep the pages.dev copies (production alias and branch previews) out of search after launch,
# so only autismga.org is indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
